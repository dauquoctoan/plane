        <table schema="planes" tableName="estimate_points" domainObjectName="EstimatePoints"/>
        <table schema="planes" tableName="estimates" domainObjectName="Estimates"/>
        <table schema="planes" tableName="exporter_histories" domainObjectName="ExporterHistories"/>
        <table schema="planes" tableName="file_assets" domainObjectName="FileAssets"/>
        <table schema="planes" tableName="flyway_schema_history" domainObjectName="FlywaySchemaHistory"/>
        <table schema="planes" tableName="global_views" domainObjectName="GlobalViews"/>
