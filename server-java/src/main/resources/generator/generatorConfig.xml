<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="MysqlContext" targetRuntime="MyBatis3">
        <property name="javaFileEncoding" value="UTF-8"/>
<!--        <property name="useActualColumnNames" value="true"/>-->
        <property name="useActualColumnNames" value="true"/>
        <property name="autoDelimitKeywords" value="true"/>
        <property name="delimitIdentifiers" value="true"/>
        <jdbcConnection
                driverClass="com.mysql.cj.jdbc.Driver"
                connectionURL="jdbc:mysql://localhost:3306/planes?useSSL=false&amp;serverTimezone=UTC"
                userId="root"
                password="123456"/>

        <!-- ENTITY -->
        <javaModelGenerator
                targetPackage="com.server.plane.entity"
                targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- MAPPER XML -->
        <sqlMapGenerator
                targetPackage="mapper"
                targetProject="src/main/resources"/>

        <!-- MAPPER INTERFACE -->
        <javaClientGenerator
                type="XMLMAPPER"
                targetPackage="com.server.plane.mapper"
                targetProject="src/main/java"/>

        <!-- ===== PLANE TABLES ===== -->
        <table schema="planes" tableName="analytic_views" domainObjectName="AnalyticViews"/>
        <table schema="planes" tableName="api_tokens" domainObjectName="ApiTokens"/>
        <table schema="planes" tableName="comment_reaction" domainObjectName="CommentReaction"/>
